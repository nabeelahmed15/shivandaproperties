<%- include('partials/header') %>

<section class="page-top">
  <div class="container">
    <h1>Turnkey construction packages</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="package-sheets" id="packages">
      <% packages.forEach((pkg, index) => { %>
        <article class="package-sheet <%= index === 1 ? 'is-highlight' : '' %>" data-rate="<%= pkg.rate %>" data-name="<%= pkg.name %>">
          <header class="package-sheet-head">
            <% if (pkg.badge) { %><span class="package-sheet-badge"><%= pkg.badge %></span><% } %>
            <h2><%= pkg.name %> Package</h2>
            <div class="package-sheet-price">
              Rs <%= Number(pkg.rate).toLocaleString('en-IN') %><span>/Sq.Ft.</span>
            </div>
          </header>

          <div class="package-sheet-body">
            <% pkg.groups.forEach((group) => { %>
              <details class="pkg-group">
                <summary>
                  <span><%= group.name %></span>
                  <span class="pkg-chevron" aria-hidden="true"></span>
                </summary>
                <dl class="pkg-items">
                  <% group.items.forEach((item) => { %>
                    <div class="pkg-item<%= /^not\s+included$/i.test(String(item.content).trim()) ? ' is-excluded' : '' %>">
                      <dt><%= item.label %></dt>
                      <dd><%= item.content %></dd>
                    </div>
                  <% }) %>
                </dl>
              </details>
            <% }) %>
          </div>

          <footer class="package-sheet-foot">
            <a class="btn btn-primary" href="/contact?interest=<%= encodeURIComponent(pkg.name) %>">Enquire about <%= pkg.name %></a>
          </footer>
        </article>
      <% }) %>
    </div>

    <p class="package-note">
      Rates are per sq ft of built-up area and cover materials, labour and finishing up to the limits listed
      in each section. Government approvals, plan sanction fees, compound wall, borewell and interior
      furniture are quoted separately. Tap any section to see exactly what is included.
    </p>

    <div class="service-card" style="margin-top:2rem; padding: 1.5rem;">
      <h3>Indicative estimate</h3>
      <p class="muted-line" style="margin-bottom: 0.75rem;">Enter your built-up area to see the total for each package.</p>
      <div class="field-row" style="align-items: end;">
        <div class="form-group">
          <label for="area-input">Built-up area (sq ft)</label>
          <input id="area-input" type="number" min="400" step="10" value="1200" />
        </div>
      </div>
      <div id="estimate-list" class="estimate-list" aria-live="polite"></div>
      <noscript><p class="muted-line">Multiply the built-up area by each package rate above.</p></noscript>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Construction services</h2>
    </div>
    <div class="grid-3">
      <article class="service-card"><h3>Residential Construction</h3><p>Custom homes, duplexes, and family living spaces designed to improve comfort and resale value.</p><a class="btn btn-secondary" href="/contact?interest=Residential%20Construction">Enquire</a></article>
      <article class="service-card"><h3>Rental Construction</h3><p>Smart layouts and efficient finishes built for consistent occupancy and lower maintenance.</p><a class="btn btn-secondary" href="/contact?interest=Rental%20Construction">Enquire</a></article>
      <article class="service-card"><h3>Commercial Construction</h3><p>Office and retail spaces with structured planning, zoning insight and modern fit-outs.</p><a class="btn btn-secondary" href="/contact?interest=Commercial%20Construction">Enquire</a></article>
      <article class="service-card"><h3>Villa Construction</h3><p>Luxury villas with elegant facades, designer detailing and premium finishes.</p><a class="btn btn-secondary" href="/contact?interest=Villa%20Construction">Enquire</a></article>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Project gallery</h2>
    </div>
    <div class="gallery-grid">
      <% gallery.forEach((item) => { %>
        <figure class="project-card">
          <img src="<%= item.image_url %>" alt="<%= item.title %>" loading="lazy" />
          <figcaption style="padding-top: 0.8rem; font-weight: 600;"><%= item.title %></figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
