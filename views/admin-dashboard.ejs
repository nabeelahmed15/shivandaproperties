<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shivanda Admin</title>
    <link rel="icon" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/styles.css?v=13" />
  </head>
  <body>
    <div class="container admin-shell">
      <aside class="admin-sidebar">
        <div class="brand"><img src="/images/logo.png" alt="Shivanda logo" style="width:180px;" /></div>
        <nav class="side-nav">
          <a href="#overview" class="active">Overview</a>
          <a href="#storage">Data storage</a>
          <a href="#security">Security</a>
          <a href="#properties">Properties</a>
          <a href="#enquiries">Enquiries</a>
          <a href="#packages">Packages</a>
          <a href="#testimonials">Testimonials</a>
          <a href="#faq">FAQ</a>
          <a href="#gallery">Gallery</a>
          <a href="#settings">Settings</a>
          <a href="/admin/logout">Logout</a>
        </nav>
      </aside>

      <main class="card-list">
        <% if (locals.notice && notice) { %>
          <div class="notice <%= notice.type %>" role="alert"><%= notice.text %></div>
        <% } %>

        <section id="storage" class="info-panel">
          <h2>Where your data is stored</h2>
          <div class="alert-status <%= storage.persistent ? 'is-on' : 'is-off' %>" role="status">
            <% if (storage.persistent) { %>
              <strong><%= storage.label %></strong> &mdash; <%= storage.note %>
            <% } else { %>
              <strong>Warning: your data is not being saved permanently.</strong> <%= storage.note %>
            <% } %>
          </div>
          <p class="muted-line">
            <%= storage.totalRecords %> records stored
            &middot; <%= storage.persistent ? 'Permanent storage' : 'Temporary storage' %>
            &middot; <%= storage.writable === false ? 'Write access problem - changes may fail to save' : 'Write access confirmed' %>
          </p>
          <% if (storage.mirror && storage.mirror.enabled) { %>
            <p class="muted-line">
              <% if (storage.mirror.lastError) { %>
                Last save failed: <strong><%= storage.mirror.lastError %></strong>
              <% } else if (storage.mirror.lastSavedAt) { %>
                Last saved to Netlify: <strong><%= formatWhen(storage.mirror.lastSavedAt) %></strong>
                (<%= Math.max(1, Math.round((storage.mirror.lastBytes || 0) / 1024)) %> KB)
              <% } else { %>
                Waiting for the first save.
              <% } %>
            </p>
          <% } %>
          <div class="field-row" style="margin-top: 1rem;">
            <a class="btn btn-primary" href="/admin/backup.json" download>Download JSON backup</a>
            <a class="btn btn-secondary" href="/admin/enquiries/export/xlsx" download>Download enquiries (Excel)</a>
          </div>
          <p class="muted-line">
            <% if (backup.available) { %>
              Latest snapshot saved on this computer: <strong><%= backup.name %></strong>
              (<%= Math.max(1, Math.round(backup.sizeBytes / 1024)) %> KB, <%= formatWhen(backup.modifiedAt) %>).
            <% } else { %>
              No local snapshot yet. One is written automatically each day the site runs, or run <code>npm run db:backup</code>.
            <% } %>
            <% if (!backup.writable) { %>This environment cannot write backup files - use the download buttons above.<% } %>
          </p>
          <div class="stats-row">
            <div class="stat-box"><strong><%= storage.rows.properties ?? 0 %></strong><br />Properties</div>
            <div class="stat-box"><strong><%= storage.rows.enquiries ?? 0 %></strong><br />Enquiries</div>
            <div class="stat-box"><strong><%= storage.rows.property_images ?? 0 %></strong><br />Property images</div>
            <div class="stat-box"><strong><%= storage.rows.packages ?? 0 %></strong><br />Packages</div>
          </div>
        </section>

        <section id="security" class="info-panel">
          <h2>Security</h2>
          <% if (security.failures.length) { %>
            <div class="alert-status is-off" role="alert">
              <strong><%= security.failures.length %> security item<%= security.failures.length === 1 ? '' : 's' %> need<%= security.failures.length === 1 ? 's' : '' %> attention:</strong>
              <%= security.failures.map((check) => check.label).join(', ') %>.
            </div>
          <% } else { %>
            <div class="alert-status is-on" role="status">
              <strong>All security checks pass.</strong> <%= security.checks.length %> protections are active on this site.
            </div>
          <% } %>
          <% if (sessionSecretWeak) { %>
            <p class="muted-line">A temporary session secret is being used for this run, so admin logins reset when the server restarts. Set <code>SESSION_SECRET</code> to stop that.</p>
          <% } %>
          <ul class="check-list">
            <% security.checks.forEach((check) => { %>
              <li class="check-item is-<%= check.status %>">
                <span class="check-badge"><%= check.status === 'pass' ? 'Pass' : (check.status === 'warn' ? 'Check' : 'Fix') %></span>
                <span><strong><%= check.label %></strong> &mdash; <%= check.detail %></span>
              </li>
            <% }) %>
          </ul>
        </section>

        <section id="overview" class="info-panel">
          <h2>Overview</h2>
          <div class="stats-row">
            <div class="stat-box"><strong><%= overview.propertyCount %></strong><br />Properties</div>
            <div class="stat-box"><strong><%= overview.publishedCount %></strong><br />Published</div>
            <div class="stat-box"><strong><%= overview.newEnquiries %></strong><br />New enquiries</div>
            <div class="stat-box"><strong><%= Object.keys(overview.byStatus || {}).length %></strong><br />Status groups</div>
          </div>
        </section>

        <section id="properties" class="info-panel">
          <h2>Properties</h2>
          <form method="POST" action="/admin/properties" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="field-row">
              <div class="form-group"><label>Title</label><input name="title" required minlength="3" /></div>
              <div class="form-group"><label>Price (₹, full amount)</label><input name="price" type="number" min="100000" step="1" required placeholder="8500000" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Type</label><select name="type"><option>Apartment</option><option>Villa</option><option>Plot</option><option>Commercial</option><option>Independent House</option></select></div>
              <div class="form-group"><label>Status</label><select name="status"><option>Available</option><option>Sold</option><option>Rented</option></select></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Locality</label><input name="locality" required minlength="2" /></div>
              <div class="form-group"><label>Address</label><input name="address" required minlength="8" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Bedrooms</label><input name="bedrooms" type="number" value="0" /></div>
              <div class="form-group"><label>Bathrooms</label><input name="bathrooms" type="number" value="0" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Area (sq ft, 0 if unknown)</label><input name="area" type="number" min="0" step="1" value="0" placeholder="1200" /></div>
              <div class="form-group"><label>Facing</label><input name="facing" value="East" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Floor</label><input name="floor" value="Ground" /></div>
              <div class="form-group"><label>Possession date</label><input name="possession_date" type="date" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Latitude</label><input name="latitude" type="number" step="any" value="12.9716" /></div>
              <div class="form-group"><label>Longitude</label><input name="longitude" type="number" step="any" value="77.5946" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>RERA ID</label><input name="rera_id" /></div>
              <div class="form-group"><label>Published</label><select name="is_published"><option value="1">Published</option><option value="0">Draft</option></select></div>
            </div>
            <div class="form-group"><label>Amenities</label><input name="amenities" placeholder="Gym, Security, Parking" /></div>
            <div class="form-group"><label>Description</label><textarea name="description" required minlength="15"></textarea></div>
            <div class="form-group"><label>Images</label><input name="images" type="file" multiple accept="image/*" /></div>
            <button class="btn btn-primary" type="submit">Add property</button>
          </form>

          <div class="table-wrap" style="margin-top: 1.5rem;">
            <table>
              <thead><tr><th>Title</th><th>Price</th><th>Status</th><th>Type</th><th>Published</th><th>Actions</th></tr></thead>
              <tbody>
                <% properties.forEach((property) => { %>
                  <tr>
                    <td><%= property.title %></td>
                    <td><%= formatPrice(property.price) %></td>
                    <td><%= property.status %></td>
                    <td><%= property.type %></td>
                    <td><%= property.is_published ? 'Yes' : 'No' %></td>
                    <td>
                      <form method="POST" action="/admin/properties/<%= property.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn btn-secondary" type="submit"><%= property.is_published ? 'Unpublish' : 'Publish' %></button></form>
                      <form method="POST" action="/admin/properties/<%= property.id %>/delete" style="margin-top: 0.5rem;"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn btn-secondary" type="submit" onclick="return confirm('Delete this property?');">Delete</button></form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>

        <section id="enquiries" class="info-panel">
          <h2>Enquiries <span class="count-pill"><%= enquiries.length %></span></h2>
          <div class="alert-status <%= whatsappAlerts.configured ? 'is-on' : 'is-off' %>" role="status">
            <% if (whatsappAlerts.configured) { %>
              <strong>WhatsApp alerts are on.</strong> Every new enquiry is also sent to <%= whatsappAlerts.recipient %> automatically via <%= whatsappAlerts.provider %>.
            <% } else { %>
              <strong>WhatsApp alerts are off.</strong> New enquiries are only saved here. Add your CallMeBot key in <a href="#settings">Settings &rsaquo; WhatsApp alerts</a> to receive each one on WhatsApp automatically.
            <% } %>
          </div>
          <form method="POST" action="/admin/whatsapp/test" style="margin-top: 0.8rem;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="btn btn-secondary" type="submit">Send a test WhatsApp alert</button>
          </form>
          <div class="field-row">
            <a class="btn btn-secondary" href="/admin/enquiries/export/csv" download="shivanda-enquiries.csv">Export CSV</a>
            <a class="btn btn-secondary" href="/admin/enquiries/export/xlsx" download="shivanda-enquiries.xlsx">Export Excel</a>
          </div>
          <div class="table-wrap" style="margin-top: 1rem;">
            <table>
              <thead><tr><th>Received</th><th>Name</th><th>Enquiry</th><th>Phone</th><th>Service</th><th>Status</th><th>Actions</th></tr></thead>
              <tbody>
                <% if (!enquiries.length) { %>
                  <tr><td colspan="7" class="empty-row">No enquiries yet. New website enquiries will appear here.</td></tr>
                <% } %>
                <% enquiries.forEach((enquiry) => { %>
                  <tr>
                    <td class="nowrap"><%= formatWhen(enquiry.created_at) %></td>
                    <td><%= enquiry.buyer_name %></td>
                    <td>
                      <strong><%= enquiry.property_name || enquiry.package_name || 'General' %></strong>
                      <% if (enquiry.email) { %><div class="cell-note">Email: <%= enquiry.email %></div><% } %>
                      <% if (enquiry.budget_range) { %><div class="cell-note">Budget: <%= enquiry.budget_range %></div><% } %>
                      <% if (enquiry.message) { %><div class="cell-note cell-message"><%= enquiry.message %></div><% } %>
                    </td>
                    <td><a class="wa-link" href="<%= whatsappChatUrl(enquiry.phone) %>" target="_blank" rel="noopener" title="Open this number in WhatsApp"><%= enquiry.phone %></a></td>
                    <td><%= enquiry.service_type %></td>
                    <td>
                      <form method="POST" action="/admin/enquiries/<%= enquiry.id %>/status">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <select name="status">
                          <option <%= enquiry.status === 'New' ? 'selected' : '' %>>New</option>
                          <option <%= enquiry.status === 'Contacted' ? 'selected' : '' %>>Contacted</option>
                          <option <%= enquiry.status === 'Follow-up' ? 'selected' : '' %>>Follow-up</option>
                          <option <%= enquiry.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                        </select>
                        <button class="btn btn-secondary" type="submit" style="margin-top: 0.5rem;">Update</button>
                      </form>
                    </td>
                    <td>
                      <form method="POST" action="/admin/enquiries/<%= enquiry.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn btn-secondary" type="submit" onclick="return confirm('Delete enquiry?');">Delete</button></form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>

        <section id="packages" class="info-panel">
          <h2>Packages</h2>
          <form method="POST" action="/admin/packages">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="field-row">
              <div class="form-group"><label>Name</label><input name="name" /></div>
              <div class="form-group"><label>Rate</label><input name="rate" type="number" /></div>
            </div>
            <div class="form-group"><label>Badge</label><input name="badge" placeholder="Most Chosen" /></div>
            <button class="btn btn-primary" type="submit">Add package</button>
          </form>
          <div class="table-wrap" style="margin-top: 1rem;">
            <table>
              <thead><tr><th>Package</th><th>Rate</th><th>Badge</th></tr></thead>
              <tbody>
                <% packages.forEach((pkg) => { %>
                  <tr>
                    <td><%= pkg.name %></td>
                    <td>₹<%= pkg.rate %></td>
                    <td><%= pkg.badge || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <p class="muted-line" style="margin-top: 1.25rem;">
            Open a package to change its name, rate, badge or its full specification sheet.
            The sheet is what visitors expand section by section on the Construction page.
          </p>

          <% packages.forEach((pkg) => { %>
            <details class="admin-package-editor">
              <summary><strong><%= pkg.name %></strong> — ₹<%= pkg.rate %>/sq ft<%= pkg.badge ? ` · ${pkg.badge}` : '' %></summary>

              <form method="POST" action="/admin/packages/<%= pkg.id %>" style="margin-top: 1rem;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <div class="field-row">
                  <div class="form-group"><label>Name</label><input name="name" value="<%= pkg.name %>" required /></div>
                  <div class="form-group"><label>Rate (₹ per sq ft)</label><input name="rate" type="number" value="<%= pkg.rate %>" required /></div>
                </div>
                <div class="form-group"><label>Badge</label><input name="badge" value="<%= pkg.badge || '' %>" placeholder="Most Chosen" /></div>
                <button class="btn btn-secondary" type="submit">Save name, rate and badge</button>
              </form>

              <form method="POST" action="/admin/packages/<%= pkg.id %>/specs" style="margin-top: 1.25rem;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <div class="form-group">
                  <label>Specification sheet</label>
                  <textarea name="specs" rows="14" spellcheck="false"><%= pkg.groups.flatMap((group) => group.items.map((item) => `${group.name} | ${item.label} | ${item.content}`)).join('\n') %></textarea>
                </div>
                <p class="muted-line">
                  One line per spec, written as <code>Section | Item | Detail</code> — for example
                  <code>Kitchen | Countertop | Granite up to ₹150/sq ft</code>.
                  Lines that share a section name are grouped under it, in this order.
                  Writing <code>Not included</code> as the detail greys the line out.
                </p>
                <button class="btn btn-primary" type="submit">Save specification sheet</button>
              </form>
            </details>
          <% }) %>
        </section>

        <section id="testimonials" class="info-panel">
          <h2>Testimonials</h2>
          <form method="POST" action="/admin/testimonials">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="field-row">
              <div class="form-group"><label>Name</label><input name="name" /></div>
              <div class="form-group"><label>Location</label><input name="location" /></div>
            </div>
            <div class="form-group"><label>Quote</label><textarea name="quote"></textarea></div>
            <div class="form-group"><label>YouTube URL</label><input name="youtube_url" /></div>
            <button class="btn btn-primary" type="submit">Add testimonial</button>
          </form>
        </section>

        <section id="faq" class="info-panel">
          <h2>FAQs</h2>
          <form method="POST" action="/admin/faqs">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="form-group"><label>Question</label><input name="question" /></div>
            <div class="form-group"><label>Answer</label><textarea name="answer"></textarea></div>
            <button class="btn btn-primary" type="submit">Add FAQ</button>
          </form>
        </section>

        <section id="gallery" class="info-panel">
          <h2>Gallery</h2>
          <form method="POST" action="/admin/gallery" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="field-row">
              <div class="form-group"><label>Title</label><input name="title" /></div>
              <div class="form-group"><label>Location</label><input name="location" /></div>
            </div>
            <div class="form-group"><label>Image</label><input type="file" name="image" accept="image/*" /></div>
            <button class="btn btn-primary" type="submit">Add gallery item</button>
          </form>
        </section>

        <section id="settings" class="info-panel">
          <h2>Settings</h2>
          <form method="POST" action="/admin/settings">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="field-row">
              <div class="form-group"><label>Phone</label><input name="phone" value="<%= settings.phone || '' %>" /></div>
              <div class="form-group"><label>WhatsApp</label><input name="whatsapp" value="<%= settings.whatsapp || '' %>" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Email</label><input name="email" value="<%= settings.email || '' %>" /></div>
              <div class="form-group"><label>Address</label><input name="address" value="<%= settings.address || '' %>" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Map link</label><input name="map_link" value="<%= settings.map_link || '' %>" /></div>
              <div class="form-group"><label>Company name</label><input name="company_name" value="<%= settings.company_name || '' %>" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Years of experience</label><input name="stats_years" value="<%= settings.stats_years || '' %>" /></div>
              <div class="form-group"><label>Properties sold</label><input name="stats_properties" value="<%= settings.stats_properties || '' %>" /></div>
            </div>
            <div class="field-row">
              <div class="form-group"><label>Homes built</label><input name="stats_homes" value="<%= settings.stats_homes || '' %>" /></div>
              <div class="form-group"><label>Happy families</label><input name="stats_families" value="<%= settings.stats_families || '' %>" /></div>
            </div>
            <h3 style="margin-top: 1.5rem;">WhatsApp alerts</h3>
          <div class="alert-status <%= whatsappAlerts.configured ? 'is-on' : 'is-off' %>" role="status" style="margin-top: 0.5rem;">
            <% if (whatsappAlerts.configured) { %>
              <strong>WhatsApp alerts are on.</strong> New enquiries are sent to <%= whatsappAlerts.recipient %> via <%= whatsappAlerts.provider %> as well as saved here.
            <% } else if (whatsappAlerts.provider) { %>
              <strong>Almost there.</strong> The <%= whatsappAlerts.provider %> key is saved but no WhatsApp number is set. Fill in the number below and save.
            <% } else { %>
              <strong>WhatsApp alerts are off.</strong> Add your CallMeBot key below and every new enquiry reaches your phone automatically.
            <% } %>
          </div>
            <ol class="muted-line" style="margin: 0 0 1rem 1.1rem; line-height: 1.7;">
              <li>Save <strong>+34 644 51 95 23</strong> in your phone contacts.</li>
              <li>Send it this message on WhatsApp: <code>I allow callmebot to send me messages</code>.</li>
              <li>It replies with an API key &mdash; paste that key below, add your number, and save.</li>
            </ol>
            <div class="field-row">
              <div class="form-group">
                <label>WhatsApp number for alerts</label>
                <input name="wa_callmebot_phone" value="<%= settings.wa_callmebot_phone || settings.whatsapp || '' %>" placeholder="+91 96860 01144" />
              </div>
              <div class="form-group">
                <label>CallMeBot API key</label>
                <input name="wa_callmebot_key" type="password" autocomplete="off" placeholder="<%= whatsappAlerts.usingSavedKey ? 'Saved - leave blank to keep it' : 'Paste the key from WhatsApp' %>" />
              </div>
            </div>
            <% if (whatsappAlerts.usingSavedKey) { %>
              <label class="muted-line" style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.75rem;">
                <input type="checkbox" name="wa_callmebot_clear" value="1" style="width:auto;" />
                Remove the saved key and turn alerts off
              </label>
            <% } %>
            <button class="btn btn-primary" type="submit">Save settings</button>
          </form>

          <form method="POST" action="/admin/password" style="margin-top: 1.5rem;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <h3>Change password</h3>
            <div class="form-group"><label>Current password</label><input type="password" name="current_password" /></div>
            <div class="form-group"><label>New password</label><input type="password" name="new_password" /></div>
            <button class="btn btn-primary" type="submit">Update password</button>
          </form>
        </section>
      </main>
    </div>
  </body>
</html>
