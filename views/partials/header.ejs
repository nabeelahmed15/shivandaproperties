<%
  // Per-page SEO is optional: a route that passes nothing still renders a
  // complete set of tags from the shared defaults.
  const seoTitle = title || 'Shivanda Properties & Construction | Real Estate and Construction in Bengaluru';
  const seoDescription = (typeof description === 'string' && description) ? description : 'Shivanda Properties & Construction offers premium real estate and construction services across Bengaluru.';
  const seoKeywords = (typeof keywords === 'string' && keywords) ? keywords : 'real estate Bengaluru, property for sale Bangalore, turnkey construction Bengaluru, construction packages Nelamangala';
  const seoOgTitle = (typeof ogTitle === 'string' && ogTitle) ? ogTitle : seoTitle;
  const seoOgType = (typeof ogType === 'string' && ogType) ? ogType : 'website';
  const seoOgImage = (typeof ogImage === 'string' && ogImage) ? ogImage : '/images/logo.webp';
  // Social cards need an absolute image URL; the site origin is the domain the
  // request actually arrived on.
  const seoOrigin = (typeof siteOrigin === 'string' && siteOrigin)
    ? siteOrigin
    : (typeof canonicalUrl === 'string' ? canonicalUrl.replace(/\/[^/]*$/, '') : '');
  const seoOgImageAbsolute = /^https?:\/\//i.test(seoOgImage) ? seoOgImage : seoOrigin + seoOgImage;
  const structuredDataBlocks = (typeof structuredData === 'object' && structuredData) ? structuredData.filter(Boolean) : [];
  // Error pages must never appear in search results.
  const robotsMeta = (typeof noindex !== 'undefined' && noindex) ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
%><!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#061f16" />
    <meta name="description" content="<%= seoDescription %>" />
    <meta name="keywords" content="<%= seoKeywords %>" />
    <meta name="robots" content="<%= robotsMeta %>" />
    <meta name="author" content="Shivanda Properties & Construction" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <meta property="og:title" content="<%= seoOgTitle %>" />
    <meta property="og:description" content="<%= seoDescription %>" />
    <meta property="og:type" content="<%= seoOgType %>" />
    <meta property="og:url" content="<%= typeof canonicalUrl === 'string' ? canonicalUrl : '' %>" />
    <meta property="og:site_name" content="Shivanda Properties & Construction" />
    <meta property="og:locale" content="en_IN" />
    <link rel="canonical" href="<%= typeof canonicalUrl === 'string' ? canonicalUrl : '' %>" />
    <meta property="og:image" content="<%= seoOgImageAbsolute %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= seoOgTitle %>" />
    <meta name="twitter:description" content="<%= seoDescription %>" />
    <meta name="twitter:image" content="<%= seoOgImageAbsolute %>" />
    <% structuredDataBlocks.forEach(function (block) { %><script type="application/ld+json"><%- JSON.stringify(block).replace(/</g, '\\u003c') %></script><% }); %>
    <title><%= seoTitle %></title>
    <link rel="icon" type="image/png" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css?v=13" />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="Shivanda home">
          <img src="/images/logo-nav.png" alt="Shivanda Properties & Construction Logo" />
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="/properties">Real Estate</a>
          <a href="/construction">Construction</a>
          <a href="/construction#packages">Packages</a>
          <a href="/#process">Process</a>
          <a href="/#faq">FAQs</a>
          <a href="/contact">Contact</a>
        </nav>
        <div class="header-actions">
          <a class="btn btn-primary admin-button" href="/admin/login">Admin</a>
          <a class="btn btn-primary enquire-button" href="/#enquire">Enquire</a>
        </div>
        <button class="menu-toggle" type="button" aria-label="Open menu">☰</button>
      </div>
    </header>

    <div class="mobile-nav" aria-label="Mobile navigation">
      <a href="/properties">Real Estate</a>
      <a href="/construction">Construction</a>
      <a href="/construction#packages">Packages</a>
      <a href="/#process">Process</a>
      <a href="/#faq">FAQs</a>
      <a href="/contact">Contact</a>
      <a href="/admin/login">Admin Login</a>
    </div>

    <main class="page-shell">
