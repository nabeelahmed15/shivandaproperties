[TEMPLATE]
PORT=3000
NODE_ENV=development
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_MAPS_API_KEY=
DATABASE_URL=
CLOUDINARY_URL=

# WhatsApp enquiry alerts (see README). Pick ONE provider or leave all blank.
# Recipient: falls back to the WhatsApp number saved in Admin > Settings.
WHATSAPP_TO=
WHATSAPP_COUNTRY_CODE=91
# 1) CallMeBot (fastest, free, personal use)
CALLMEBOT_APIKEY=
CALLMEBOT_PHONE=
# 2) Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: only if the owner has not messaged your business number in the last
# 24 hours. The template must have a single body variable.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# 3) Twilio WhatsApp (sandbox or approved business number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional: where local backups and the local SQLite file are written.
# Leave blank to use backups/ and data/ inside the project folder.
BACKUP_DIR=
DATA_DIR=
